# Dependencies (reinstalled in the builder stage)
node_modules

# Build output (rebuilt in the builder stage)
build
.svelte-kit

# Development files
.git
.gitignore
.env
.env.*
!.env.example

# Local runtime data must NOT enter the image (SQLite data + user homes)
/data
/home

# Local TLS/secrets directory (CA certs live on the host, never in the image)
secrets

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# Tests (unit/integration suites do not ship in the runtime image)
*.test.ts
*.spec.ts
__tests__
tests

# Database files (created in the volume at runtime)
*.db
*.db-journal
*.db-wal
*.db-shm

# Temporary files
*.log
*.tmp
.cache