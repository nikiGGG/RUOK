# RUOK environment template (WP09 / T035 / WP11).
#
# Copy to `.env` and adjust. No secrets are ever baked into the image; every
# credential is supplied at deploy time via environment variables or mounted
# secret files.
#
#     cp .env.example .env
#
# Full database reference (both backends, migration and backup/recovery):
# see docs/DATABASES.md. CNPG deployment handoff: docs/CNPG-HANDOFF.md.

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# One of `sqlite` (default) or `postgres`. Unknown values are rejected (no
# silent fallback).
DATABASE_TYPE=sqlite

# ---------------------------------------------------------------------------
# SQLite (used when DATABASE_TYPE=sqlite)
# ---------------------------------------------------------------------------
# Filesystem path to the SQLite database file inside the container.
# The default is /app/data/okr.db (WORKDIR /app). Override only if needed.
DATABASE_PATH=/app/data/okr.db

# Journal mode: `wal` (default) or `delete`.
# SQLITE_JOURNAL_MODE=wal

# Busy timeout in ms (default 5000).
# SQLITE_BUSY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# PostgreSQL (used when DATABASE_TYPE=postgres)
# ---------------------------------------------------------------------------
# Required for postgres mode. Full connection string.
# Example: postgresql://ruok:change-me@db.example.com:5432/ruok
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# TLS verification: `disable` (default) or `verify-full`.
# `verify-full` REQUIRES DATABASE_SSL_CA_FILE and never silently downgrades.
# DATABASE_SSL_MODE=disable

# Container path to the CA certificate when using verified TLS. Mount the host
# CA into ./secrets/ and set this to /run/secrets/ca.pem (see compose.postgres.yml).
# DATABASE_SSL_CA_FILE=/run/secrets/ca.pem

# Bounded pool / timeout settings (optional, validated).
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Migration (standalone CLI, shipped in the image)
# ---------------------------------------------------------------------------
# `npm run db:migrate` migrates the selected backend.
# `MIGRATION_MODE=verify` runs schema verification only (no DDL) — set it to
# verify readiness without migrating.
# MIGRATION_MODE=migrate

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HTTP port/host the adapter-node server listens on.
PORT=3000
HOST=0.0.0.0

# Username that gets admin privileges on login.
# ADMIN_USERNAME=youruser

# ---------------------------------------------------------------------------
# Docker compose (SQLite) only
# ---------------------------------------------------------------------------
# Where the SQLite database volume is stored on the host. A Docker named volume
# (`ruok_data`) is used by default; set DATA_DIR to a host path to override.
# DATA_DIR=/mnt/data/ruok